{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://www.hipha.mx/api/:path*"
    }
  ],
  "ignoreCommand": "git diff HEAD^ HEAD --quiet ."
}