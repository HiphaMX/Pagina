{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(html|)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/Assets/(.*)\\.(webp|jpg|jpeg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/propiedad",
      "has": [{ "type": "query", "key": "id", "value": "5" }],
      "destination": "/propiedad-5",
      "permanent": false
    },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "id", "value": "5" }],
      "destination": "/propiedad-5",
      "permanent": false
    },
    {
      "source": "/propiedad",
      "has": [{ "type": "query", "key": "nombre", "value": ".*encinos.*" }],
      "destination": "/propiedad-5",
      "permanent": false
    },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "nombre", "value": ".*encinos.*" }],
      "destination": "/propiedad-5",
      "permanent": false
    },
    {
      "source": "/propiedad",
      "has": [{ "type": "query", "key": "id", "value": "1" }],
      "destination": "/propiedad-1",
      "permanent": false
    },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "id", "value": "1" }],
      "destination": "/propiedad-1",
      "permanent": false
    },
    {
      "source": "/propiedad",
      "has": [{ "type": "query", "key": "id", "value": "2" }],
      "destination": "/propiedad-2",
      "permanent": false
    },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "id", "value": "2" }],
      "destination": "/propiedad-2",
      "permanent": false
    },
    {
      "source": "/propiedad",
      "has": [{ "type": "query", "key": "id", "value": "3" }],
      "destination": "/propiedad-3",
      "permanent": false
    },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "id", "value": "3" }],
      "destination": "/propiedad-3",
      "permanent": false
    },
    {
      "source": "/propiedad",
      "has": [{ "type": "query", "key": "id", "value": "4" }],
      "destination": "/propiedad-4",
      "permanent": false
    },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "id", "value": "4" }],
      "destination": "/propiedad-4",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.hipha.mx/api/:path*"
    },
    {
      "source": "/casa-en-venta-en-los-robles-coto-encinos",
      "destination": "/propiedad-5.html"
    },
    {
      "source": "/casa-en-renta-en-los-robles-residencial",
      "destination": "/propiedad-1.html"
    },
    {
      "source": "/residencia-de-autor-valle-imperial",
      "destination": "/propiedad-2.html"
    },
    {
      "source": "/loft-boutique-providencia",
      "destination": "/propiedad-3.html"
    },
    {
      "source": "/lote-residencial-sunset-telchac",
      "destination": "/propiedad-4.html"
    },
    {
      "source": "/propiedad",
      "destination": "/propiedad.html"
    },
    {
      "source": "/aviso-de-privacidad",
      "destination": "/aviso-de-privacidad.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos-y-condiciones.html"
    }
  ],
  "ignoreCommand": "git diff HEAD^ HEAD --quiet ."
}
