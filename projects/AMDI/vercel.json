{
  "cleanUrls": true,
  "ignoreCommand": "git diff HEAD^ HEAD --quiet .",
  "redirects": [
    {
      "source": "/.well-known/:path*",
      "destination": "http://mail.amdi.mx/.well-known/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.hipha.mx/api/:path*"
    }
  ]
}
