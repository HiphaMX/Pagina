{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self' https://api.whatsapp.com https://www.instagram.com"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "projects/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/dashboard",
      "dest": "projects/HiphaMX/dashboard/index.html"
    },
    {
      "src": "/(terminos-y-condiciones|aviso-de-privacidad|letrerama|neon-configurador-premium)\\.html",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "/terminos-y-condiciones",
      "dest": "/terminos-y-condiciones.html"
    },
    {
      "src": "/aviso-de-privacidad",
      "dest": "/aviso-de-privacidad.html"
    },
    {
      "src": "/letrerama",
      "dest": "/letrerama.html"
    },
    {
      "src": "/neon-configurador-premium",
      "dest": "/neon-configurador-premium.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
