{
  "cleanUrls": true,
  "ignoreCommand": "! git diff HEAD^ HEAD --name-only | grep -qvE '^(projects/HealthyIce/|projects/BoticaSilvestre/|projects/ValenciaServicios/|projects/ChileChillon/|projects/WhiteClean/|projects/AMDI/|projects/urologia-avanzada/|projects/GrupoGari/|projects/Centro Escolar El Paraiso/|projects/uro-oncology/)'",
  "functions": {
    "api/index.py": {
      "excludeFiles": "projects/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self' https://api.whatsapp.com https://www.instagram.com"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?amdi\\.mx$"
        }
      ],
      "dest": "/projects/AMDI/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?urologia-avanzada\\.com\\.mx$"
        }
      ],
      "dest": "/projects/urologia-avanzada/$1"
    },
    {
      "src": "/amdi",
      "status": 308,
      "headers": { "Location": "/amdi/" }
    },
    {
      "src": "/amdi/",
      "dest": "/projects/AMDI/"
    },
    {
      "src": "/amdi/(.*)",
      "dest": "/projects/AMDI/$1"
    },
    {
      "src": "/urologia-avanzada",
      "status": 308,
      "headers": { "Location": "/urologia-avanzada/" }
    },
    {
      "src": "/urologia-avanzada/",
      "dest": "/projects/urologia-avanzada/"
    },
    {
      "src": "/urologia-avanzada/(.*)",
      "dest": "/projects/urologia-avanzada/$1"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/dashboard",
      "dest": "/projects/HiphaMX/dashboard"
    },
    {
      "src": "/(terminos-y-condiciones|aviso-de-privacidad)\\.html",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "/letrerama",
      "status": 308,
      "headers": { "Location": "/letrerama/" }
    },
    {
      "src": "/letrerama\\.html",
      "status": 308,
      "headers": { "Location": "/letrerama/" }
    },

    {
      "src": "/terminos-y-condiciones",
      "dest": "/terminos-y-condiciones.html"
    },
    {
      "src": "/aviso-de-privacidad",
      "dest": "/aviso-de-privacidad.html"
    },
    {
      "src": "/letrerama/",
      "dest": "/projects/Letrerama/web/"
    },
    {
      "src": "/letrerama/(.*)",
      "dest": "/projects/Letrerama/web/$1"
    },
    {
      "src": "/valencia-servicios",
      "dest": "/projects/ValenciaServicios/"
    },
    {
      "src": "/Assets/(.*)",
      "dest": "/projects/ValenciaServicios/Assets/$1"
    },
    {
      "src": "/ni2",
      "status": 308,
      "headers": { "Location": "/ni2/" }
    },
    {
      "src": "/ni2/",
      "dest": "/projects/ni2/web/"
    },
    {
      "src": "/ni2/(css|js)/(.*)",
      "dest": "/projects/ni2/web/$1/$2"
    },
    {
      "handle": "filesystem"
    }
  ]
}
